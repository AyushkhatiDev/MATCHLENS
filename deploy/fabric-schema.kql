// Preserve the entire existing EventEnvelope and canonical nested payload.
.create-merge table MatchEvents (correlation_id:string, envelope:dynamic, match_id:string, event_id:string, event_type:string, timestamp:real, team_id:string, player_id:string)
.create-or-alter table MatchEvents ingestion json mapping 'matchlens_envelope' '[{"column":"correlation_id","Properties":{"path":"$.correlation_id"}},{"column":"envelope","Properties":{"path":"$"}},{"column":"match_id","Properties":{"path":"$.match_id"}},{"column":"event_id","Properties":{"path":"$.event_id"}},{"column":"event_type","Properties":{"path":"$.event_type"}},{"column":"timestamp","Properties":{"path":"$.payload.timestamp"}},{"column":"team_id","Properties":{"path":"$.payload.team_id"}},{"column":"player_id","Properties":{"path":"$.payload.player_id"}}]'
