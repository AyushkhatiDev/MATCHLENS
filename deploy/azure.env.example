# Copy to a gitignored file; replace non-secret resource identifiers before startup.
# Use a dedicated Event Hubs consumer group and managed identity with RBAC.
APP_ENV=azure
APP_FRONTEND_ORIGINS=https://your-web-app.azurecontainerapps.io
APP_DEMO_CONTROLS=false
APP_DIAGNOSTICS=false
APP_AUTOSTART=true
EVENT_SOURCE=eventhub
AGENTIC_MODE=foundry
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
AZURE_CLIENT_ID=
AZURE_EVENT_HUB_FULLY_QUALIFIED_NAMESPACE=your-namespace.servicebus.windows.net
AZURE_EVENT_HUB_NAME=your-event-hub
AZURE_EVENT_HUB_CONSUMER_GROUP=$Default
LOG_LEVEL=INFO
REALTIME_QUEUE_SIZE=64
APP_MAX_SSE_SUBSCRIBERS=100
APP_SSE_SECONDS=180
# Actual Fabric values must come from the capacity-backed workspace/items.
FABRIC_WORKSPACE_ID=
FABRIC_EVENTSTREAM_ID=
FABRIC_EVENTHOUSE_ID=
FABRIC_KQL_ENDPOINT=
FABRIC_KQL_DATABASE=

REALTIME_BATCH_SIZE=32
REALTIME_FLUSH_SECONDS=0.25
REALTIME_PUBLISH_TIMEOUT_SECONDS=30

# Fabric items were browser-verified with the owning account; current Azure CLI identity cannot access them.
# FABRIC_KQL_ENDPOINT remains blank until the actual query URI is read from database details.
