# Azure Container Apps environment for the public judge demo (see deploy/public-demo.md).
# Values here are placeholders. Set real values in the container app, never in this file.
APP_PUBLIC_DEMO=true
# Exactly one HTTPS origin: the Vercel production URL that browsers open.
APP_FRONTEND_ORIGINS=https://your-project.vercel.app
# mock = no paid AI calls; every moment is labelled MOCK. Switch to foundry only with the settings below.
AGENTIC_MODE=mock
# Trust X-Forwarded-Proto from the Container Apps ingress so the session cookie is issued Secure.
FORWARDED_ALLOW_IPS=*
LOG_LEVEL=INFO
APP_MAX_SSE_SUBSCRIBERS=100
# Must stay below the 240-second Container Apps ingress request timeout (validated range 15-210).
APP_SSE_SECONDS=180

# Live Foundry mode only (real, billed model requests). Store endpoint/model as Container Apps secrets
# and reference them with secretref:. AZURE_CLIENT_ID selects the user-assigned managed identity.
# AGENTIC_MODE=foundry
# FOUNDRY_PROJECT_ENDPOINT=secretref:foundry-endpoint
# FOUNDRY_MODEL=secretref:foundry-model
# AZURE_CLIENT_ID=
# AGENTIC_TIMEOUT_SECONDS=60
# Leave FOUNDRY_AGENT_ID unset.
