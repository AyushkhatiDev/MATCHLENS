# Offline mode: no Azure credentials or network requests.
AGENTIC_MODE=mock
AGENTIC_TIMEOUT_SECONDS=60

# Foundry mode requires a real project endpoint and deployed model name.
# AGENTIC_MODE=foundry
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=

# Optional identity metadata. DefaultAzureCredential uses your Azure CLI login,
# managed identity, or standard Azure identity environment variables.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# Reserved for service-managed agents. Leave blank for this code-defined runtime.
FOUNDRY_AGENT_ID=
# FOUNDY_PROJECT_ENDPOINT is accepted as a legacy spelling; prefer FOUNDRY_.

# Phase 5 — export these in your shell; .env is not loaded automatically.
REALTIME_QUEUE_SIZE=64
REALTIME_MAX_ATTEMPTS=3
REALTIME_BACKOFF_SECONDS=0.5
REALTIME_RECEIVE_TIMEOUT_SECONDS=60
AZURE_EVENT_HUB_FULLY_QUALIFIED_NAMESPACE=
AZURE_EVENT_HUB_NAME=
# Prefer a dedicated demo consumer group, separate from Fabric/other consumers.
AZURE_EVENT_HUB_CONSUMER_GROUP=$Default
# Optional explicit local-development fallback; prefer DefaultAzureCredential.
AZURE_EVENT_HUB_CONNECTION_STRING=
# Optional integration test against an existing real Azure Event Hub.
MATCHLENS_RUN_EVENTHUB_TESTS=0

# Phase 6 presentation API (optional replay override).
MATCHLENS_DEMO_PATH=data/generated/phase5/seed99/match.jsonl
# Frontend public endpoint belongs in frontend/.env.local; see frontend/.env.example.

# Phase 7 APPLICATION / OBSERVABILITY. Explicit profiles: deploy/*.env.example.
# .env is not automatically loaded; shell/uvicorn --env-file/containers provide it.
APP_ENV=local
APP_FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
APP_DEMO_CONTROLS=true
APP_AUTOSTART=false
APP_DIAGNOSTICS=true
APP_MAX_SSE_SUBSCRIBERS=100
APP_SSE_SECONDS=180
EVENT_SOURCE=local
LOG_LEVEL=INFO
# FABRIC read-only verification. No resource is implicitly provisioned.
FABRIC_KQL_ENDPOINT=
FABRIC_KQL_DATABASE=
# DATABASE: not used. No database credential is required.

# Server-side realtime publishing: bounded count/timer flush and per-attempt timeout
REALTIME_BATCH_SIZE=32
REALTIME_FLUSH_SECONDS=0.25
REALTIME_PUBLISH_TIMEOUT_SECONDS=30
