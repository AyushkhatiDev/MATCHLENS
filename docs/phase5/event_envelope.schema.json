{
  "$defs": {
    "EventType": {
      "description": "Catalogue of recognised event types.",
      "enum": [
        "MATCH_START",
        "HALF_TIME",
        "SECOND_HALF_START",
        "MATCH_END",
        "PASS",
        "SHOT",
        "TACKLE",
        "POSSESSION_CHANGE",
        "PRESSURE",
        "CARRY",
        "INTERCEPTION",
        "RECOVERY",
        "CROSS",
        "FOUL",
        "CORNER",
        "FREE_KICK",
        "GOAL_KICK",
        "GOAL"
      ],
      "title": "EventType",
      "type": "string"
    },
    "MatchEvent": {
      "description": "Base event \u2014 every event in the match stream inherits these fields.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "timestamp": {
          "description": "Simulation time in seconds from kick-off.",
          "minimum": 0.0,
          "title": "Timestamp",
          "type": "number"
        },
        "minute": {
          "description": "Match minute (0-indexed display minute).",
          "minimum": 0,
          "title": "Minute",
          "type": "integer"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "MATCH_START",
            "HALF_TIME",
            "SECOND_HALF_START",
            "MATCH_END"
          ]
        },
        "team_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team Id"
        },
        "player_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Id"
        },
        "start_x": {
          "anyOf": [
            {
              "maximum": 105.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start X"
        },
        "start_y": {
          "anyOf": [
            {
              "maximum": 68.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Y"
        },
        "possession_sequence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Possession Sequence Id"
        },
        "synthetic": {
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "event_id",
        "match_id",
        "timestamp",
        "minute",
        "event_type"
      ],
      "title": "MatchEvent",
      "type": "object"
    },
